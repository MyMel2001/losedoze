#!/bin/sh
# Losedoze early userspace. Backing media is read-only, so writable areas
# live on tmpfs; binaries/config on the rootfs stay read-only.
# NOTE: /dev must be mounted on the first line, without stderr redirects —
# until devtmpfs is up, /dev/null does not exist and redirections abort lines.
mount -t devtmpfs devtmpfs /dev

mount -t proc proc /proc 2>/dev/null
mount -t sysfs sysfs /sys 2>/dev/null
mkdir -p /dev/pts /dev/shm
mount -t devpts devpts /dev/pts 2>/dev/null

# Writable areas. The live medium is read-only, so /root and /var are tmpfs
# overlays. An installed system (/etc/losedoze/installed is written by
# losinstall) runs from the disk: there /root and /var stay on the disk so
# files survive a reboot. /tmp and /run are runtime state either way.
if [ -f /etc/losedoze/installed ]; then
    mount -t tmpfs tmpfs /tmp 2>/dev/null
    mount -t tmpfs tmpfs /run 2>/dev/null
    # the swap partition from /etc/fstab (busybox swapon -a reads it)
    swapon -a 2>/dev/null
    echo "LOSEDOZE SWAP: $(grep SwapTotal /proc/meminfo 2>/dev/null)" > /dev/console
else
    mount -t tmpfs -o size=1024m tmpfs /root 2>/dev/null
    mount -t tmpfs -o size=256m tmpfs /var 2>/dev/null
    mount -t tmpfs tmpfs /tmp 2>/dev/null
    mount -t tmpfs tmpfs /run 2>/dev/null
fi
mkdir -p /run/losedoze /var/log /var/cache /var/tmp /root/.config

hostname -F /etc/hostname 2>/dev/null

# GPU: devtmpfs nodes first, then the in-tree DRM/KMS drivers (modules.dep
# built at image build). Every candidate is loaded so each attached GPU gets
# its driver (the first one to bind a card wins); failures are OK (no device).
# The open-source stack: bochs (QEMU std VGA), virtio-gpu, i915/xe, amdgpu,
# nouveau, radeon.
KVER=$(ls /lib/modules 2>/dev/null | head -1)
if [ -n "$KVER" ]; then
    for d in bochs_drm virtio_gpu i915 xe amdgpu nouveau radeon; do
        modprobe "$d" 2>/dev/null
    done
fi

# PCI coldplug: no udev in this image, so load the driver each device's
# modalias names (NICs, wifi, USB, audio, extra GPUs, ...).
if [ -d /sys/bus/pci/devices ]; then
    for a in /sys/bus/pci/devices/*/modalias; do
        [ -r "$a" ] || continue
        m=$(cat "$a" 2>/dev/null)
        [ -n "$m" ] && modprobe "$m" 2>/dev/null
    done
fi

# Network: the NIC drivers above provide the interface; bring the first one up
# with DHCP (busybox udhcpc) in the background so boot does not wait on it.
: > /run/resolv.conf 2>/dev/null
if [ -x /usr/local/bin/losenet ]; then
    ( /usr/local/bin/losenet up > /dev/console 2>&1 ) &
fi

echo "LOSEDOZE INIT OK" > /dev/console
exit 0
