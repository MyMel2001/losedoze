#!/bin/sh
# Losedoze initramfs: mount the live medium, switch to rootfs.ext4.
# An installed system has no medium: its root is the ext4 partition labelled
# LOSEDOZE, found by scanning the block devices.
export PATH=/bin:/sbin:/usr/bin:/usr/sbin
log() { echo "$*" > /dev/console; }

# devtmpfs first, no redirects: /dev/null does not exist before it mounts
mount -t devtmpfs devtmpfs /dev
mount -t proc proc /proc 2>/dev/null
mount -t sysfs sysfs /sys 2>/dev/null
mkdir -p /dev/pts
mount -t devpts devpts /dev/pts 2>/dev/null

insmod /modules/loop.ko 2>/dev/null || log "LOSEDOZE INIT: insmod loop.ko failed"
insmod /modules/isofs.ko 2>/dev/null || true
# loop module creates no pre-set devices (MIN_COUNT=0); the control node
# is what mount/losetup use to allocate one.
[ -e /dev/loop-control ] || mknod /dev/loop-control c 10 237 2>/dev/null

mkdir -p /cdrom
for d in /dev/sr0 /dev/sr1 /dev/sr2; do
    mount -t iso9660 -o ro "$d" /cdrom 2>/dev/null && { log "LOSEDOZE INIT: medium mounted on $d"; break; }
done

if [ -f /cdrom/rootfs.ext4 ]; then
    if mount -t ext4 -o loop /cdrom/rootfs.ext4 /newroot; then
        log "LOSEDOZE SWITCHROOT"
        exec switch_root /newroot /sbin/init
    fi
    log "LOSEDOZE INIT: loop mount of rootfs.ext4 failed"
    log "loop devices: $(ls /dev/loop* 2>/dev/null | tr '\n' ' ')"
    ls -la /sys/block | head -20 > /dev/console
    exec sh
fi

# No live medium -> this is an installed system. Its root is an ext4
# filesystem labelled LOSEDOZE. ext4 superblock: magic 0xEF53 at byte 56 of
# the superblock (file offset 1024+56), volume label at 1024+120 (16 bytes).
# The label is what makes the root unambiguous -- a plain "mount every ext4
# partition" would happily boot the wrong disk.
find_installed_root() {
    for d in /sys/block/*; do
        n=${d#/sys/block/}
        case "$n" in
            loop*|ram*|sr*|fd*|dm-*|zram*|md*|nbd*|bcache*) continue ;;
        esac
        for s in 1 2 3 4 p1 p2 p3 p4; do
            p=/dev/$n$s
            [ -b "$p" ] || continue
            m=$(dd if="$p" bs=1 skip=1080 count=2 2>/dev/null | od -An -tx1 | tr -d ' \n')
            [ "$m" = "53ef" ] || continue
            l=$(dd if="$p" bs=1 skip=1144 count=16 2>/dev/null | tr -d '\000' \
                | tr -c 'A-Za-z0-9_.-' ' ' | sed 's/ *$//')
            [ "$l" = "LOSEDOZE" ] || continue
            echo "$p"
            return 0
        done
    done
    return 1
}

ROOT=$(find_installed_root)
if [ -z "$ROOT" ]; then
    log "LOSEDOZE INIT: rootfs.ext4 not found on medium"
    log "LOSEDOZE INIT: no installed root found"
    ls -la /cdrom > /dev/console 2>&1
    ls -la /sys/block | head -20 > /dev/console
    exec sh
fi

log "LOSEDOZE INIT: installed root on $ROOT"
if mount -t ext4 -o rw "$ROOT" /newroot; then
    log "LOSEDOZE SWITCHROOT"
    exec switch_root /newroot /sbin/init
fi
log "LOSEDOZE INIT: mount of $ROOT failed"
exec sh
